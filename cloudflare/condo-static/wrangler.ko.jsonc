// /ko/condo/* on passionaryestate.com, served as static HTML from the export
// (.github/workflows/condo-static.yml). One Worker per locale because a
// Workers Free version holds at most 20,000 assets and each locale is
// ~15,400 pages.
{
  "name": "pe-condo-ko",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "../../dist/condo-static/ko",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "passionaryestate.com/ko/condo/*", "zone_name": "passionaryestate.com" }
  ]
}
